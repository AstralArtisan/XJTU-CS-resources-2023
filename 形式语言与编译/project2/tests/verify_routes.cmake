function(run_qcompiler output_prefix)
    execute_process(
        COMMAND "${QCOMPILER_EXE}" "${QCOMPILER_SOURCE}" ${ARGN} --out "${output_prefix}"
        RESULT_VARIABLE result
        OUTPUT_VARIABLE stdout
        ERROR_VARIABLE stderr
    )
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "qcompiler failed for ${output_prefix}: ${stderr}${stdout}")
    endif()
endfunction()

function(require_file path)
    if(NOT EXISTS "${path}")
        message(FATAL_ERROR "expected generated file does not exist: ${path}")
    endif()
endfunction()

function(reject_file path)
    if(EXISTS "${path}")
        message(FATAL_ERROR "unexpected generated file exists: ${path}")
    endif()
endfunction()

function(require_contains path pattern)
    file(READ "${path}" content)
    if(NOT content MATCHES "${pattern}")
        message(FATAL_ERROR "${path} does not contain required pattern: ${pattern}")
    endif()
endfunction()

get_filename_component(output_dir "${QCOMPILER_ROUTE_OUT}" DIRECTORY)
file(REMOVE_RECURSE "${output_dir}")
file(MAKE_DIRECTORY "${output_dir}")

run_qcompiler("${QCOMPILER_ROUTE_OUT}")
run_qcompiler("${QCOMPILER_ROUTE_OUT}A" --route A)
run_qcompiler("${QCOMPILER_ROUTE_OUT}B" --route B)
run_qcompiler("${QCOMPILER_ROUTE_OUT}C" --route C)

foreach(prefix IN ITEMS "${QCOMPILER_ROUTE_OUT}A" "${QCOMPILER_ROUTE_OUT}B" "${QCOMPILER_ROUTE_OUT}C")
    foreach(suffix IN ITEMS tokens qtac symtab s opt.s sigma)
        require_file("${prefix}.${suffix}")
    endforeach()
    require_contains("${prefix}.qtac" "i80 a;")
    require_contains("${prefix}.qtac" "define partition\\(arr, low, high\\)")
    require_contains("${prefix}.qtac" "CALL qsort, 3")
    require_contains("${prefix}.qtac" "IF")
    require_contains("${prefix}.qtac" "M\\[")
    require_contains("${prefix}.sigma" "sigma-DFA")
    require_contains("${prefix}.sigma" "T_IF_LABEL")
    require_contains("${prefix}.sigma" "T_LDR2")
    require_contains("${prefix}.sigma" "T_STR2")
endforeach()

file(READ "${QCOMPILER_ROUTE_OUT}A.sigma" sigma_a)
file(READ "${QCOMPILER_ROUTE_OUT}B.sigma" sigma_b)
file(READ "${QCOMPILER_ROUTE_OUT}C.sigma" sigma_c)
if(NOT sigma_a STREQUAL sigma_b OR NOT sigma_b STREQUAL sigma_c)
    message(FATAL_ERROR "sigma DFA description differs across routes A/B/C")
endif()

require_file("${QCOMPILER_ROUTE_OUT}A.qast")
reject_file("${QCOMPILER_ROUTE_OUT}A.slr")
require_file("${QCOMPILER_ROUTE_OUT}B.qast")
require_file("${QCOMPILER_ROUTE_OUT}B.slr")
reject_file("${QCOMPILER_ROUTE_OUT}C.qast")
require_file("${QCOMPILER_ROUTE_OUT}C.slr")

foreach(prefix IN ITEMS "${QCOMPILER_ROUTE_OUT}A" "${QCOMPILER_ROUTE_OUT}B")
    require_contains("${prefix}.qast" "Function name=swap")
    require_contains("${prefix}.qast" "Function name=partition")
    require_contains("${prefix}.qast" "Function name=qsort")
    require_contains("${prefix}.qast" "ArrayLoad")
    require_contains("${prefix}.qast" "Call name=qsort")
    require_contains("${prefix}.qast" "If")
    require_contains("${prefix}.qast" "While")
endforeach()

foreach(prefix IN ITEMS "${QCOMPILER_ROUTE_OUT}B" "${QCOMPILER_ROUTE_OUT}C")
    require_contains("${prefix}.slr" "unresolved conflicts: 0")
endforeach()

foreach(suffix IN ITEMS qtac slr s opt.s sigma)
    file(READ "${QCOMPILER_ROUTE_OUT}.${suffix}" default_output)
    file(READ "${QCOMPILER_ROUTE_OUT}C.${suffix}" route_c_output)
    if(NOT default_output STREQUAL route_c_output)
        message(FATAL_ERROR "default route output differs from explicit route C for .${suffix}")
    endif()
endforeach()
